# Azure credentials (service principal)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# ADLS Gen2 storage
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_CONTAINER=raw

# Optional: use connection string for local dev (overrides SP auth)
AZURE_STORAGE_CONNECTION_STRING=

# REST API source
REST_API_BASE_URL=https://api.yourecommerce.com
REST_API_TOKEN=your-bearer-token-here

# SQL Server / Azure SQL (JDBC source)
JDBC_HOST=your-sql-server.database.windows.net
JDBC_PORT=1433
JDBC_DATABASE=orders_db
JDBC_USERNAME=etl_user
JDBC_PASSWORD=your-db-password-here

# Logging
LOG_LEVEL=INFO
